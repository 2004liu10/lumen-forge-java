# 复制成 .env 并按需修改（.env 已在 .gitignore 中，不会被提交）
# 注意：本项目读取的是「环境变量」，.env 需要由 shell / IDE / docker 注入，不是自动加载。

# ---- 必填 ----
# 凭据加密主密钥。生成方式：openssl rand -base64 32
# 必须稳定：一旦修改，已保存的账号密钥将无法解密。
APP_CREDENTIAL_KEY=

# ---- 数据库 ----
DB_URL=jdbc:mysql://127.0.0.1:3306/lumen_forge?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# ---- 服务 ----
# SERVER_PORT=8080
# app.storage.root=./data
